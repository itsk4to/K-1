--// KÉO THẢ CỬA SỔ (DRAGGING) MƯỢT MÀ
local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ================== FUNCTIONS (GIỮ NGUYÊN GỐC V7) ==================
local function ModifyAmmo(tool)
    pcall(function()
        for _, obj in pairs(tool:GetDescendants()) do
            if obj:IsA("IntValue") or obj:IsA("NumberValue") then
                local name = obj.Name:lower()
                if name:find("ammo") or name:find("clip") or name:find("mag") or name:find("bullet") or name:find("current") then
                    obj.Value = Settings.AmmoAmount
                elseif name:find("reserve") or name:find("stock") or name:find("total") then
                    obj.Value = Settings.ReserveAmount
                end
                
                -- Modifiers
                if Settings.Modifiers then
                    if name:find("recoil") or name:find("spread") or name:find("sway") or name:find("bloom") then
                        obj.Value = 0
                    elseif name:find("firerate") or name:find("rof") or name:find("rate") then
                        obj.Value = math.max(obj.Value or 100, 800)
                    elseif name:find("delay") or name:find("cooldown") then
                        obj.Value = 0.01
                    end
                end
            end
        end
    end)
end

-- ================== MAIN LOOP ==================
local connection

local function StartLoop()
    if connection then connection:Disconnect() end
    connection = RunService.Heartbeat:Connect(function()
        if not Settings.Enabled then return end
        
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                ModifyAmmo(tool)
            end
        end
    end)
end

local function StopLoop()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

-- ================== TOGGLE ==================
local function Toggle()
    Settings.Enabled = not Settings.Enabled
    if Settings.Enabled then
        StartLoop()
        StatusLabel.Text = "Status: ON (inf)"
        StatusLabel.TextColor3 = Theme.Green
        ToggleButton.BackgroundColor3 = Theme.Green
        print("🟢 v7 Infinite Ammo ENABLED")
    else
        StopLoop()
        StatusLabel.Text = "Status: OFF"
        StatusLabel.TextColor3 = Theme.Red
        ToggleButton.BackgroundColor3 = Theme.Accent
        print("🔴 v7 Infinite Ammo DISABLED")
    end
end

ToggleButton.MouseButton1Click:Connect(Toggle)

HideButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    RestoreButton.Visible = true
end)

RestoreButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    RestoreButton.Visible = false
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert then
        Toggle()
    end
end)

