local function makeGameCard(parent, gameInfo, order)
    local card = create("Frame", {
        Name = gameInfo.Id .. "Card",
        LayoutOrder = order or 1,
        BackgroundColor3 = COLORS.Surface2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, parent)
    corner(card, 14)
    local cardStroke = stroke(card, COLORS.Border, 0.22)

    local artwork = create("Frame", {
        Name = "Artwork",
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.new(1, -16, 0, 64),
        BackgroundColor3 = Color3.fromRGB(54, 40, 86),
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, card)
    corner(artwork, 10)
    create("UIGradient", {
        Color = ColorSequence.new(COLORS.Purple, Color3.fromRGB(42, 34, 62)),
        Rotation = 20,
    }, artwork)

    if gameInfo.Image and gameInfo.Image ~= "" then
        create("ImageLabel", {
            Name = "GameImage",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Image = gameInfo.Image,
            ScaleType = Enum.ScaleType.Crop,
        }, artwork)
    else
        create("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = gameInfo.ShortName,
            TextColor3 = Color3.fromRGB(241, 232, 255),
            Font = Enum.Font.GothamBlack,
            TextSize = 29,
        }, artwork)
    end

    local category = create("TextLabel", {
        Name = "Category",
        Position = UDim2.fromOffset(12, 79),
        Size = UDim2.new(1, -24, 0, 13),
        BackgroundTransparency = 1,
        Text = getGameText(gameInfo, "Category"),
        TextColor3 = COLORS.PurpleLight,
        Font = Enum.Font.GothamBold,
        TextSize = 8,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local title = create("TextLabel", {
        Name = "Title",
        Position = UDim2.fromOffset(12, 94),
        Size = UDim2.new(1, -24, 0, 20),
        BackgroundTransparency = 1,
        Text = getGameText(gameInfo, "Name"),
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local description = create("TextLabel", {
        Name = "Description",
        Position = UDim2.fromOffset(12, 115),
        Size = UDim2.new(1, -24, 0, 25),
        BackgroundTransparency = 1,
        Text = getGameText(gameInfo, "Description"),
        TextColor3 = COLORS.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    }, card)

    local favoriteButton = create("TextButton", {
        Name = "FavoriteButton",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -10, 1, -9),
        Size = UDim2.fromOffset(29, 25),
        BackgroundColor3 = COLORS.Surface3,
        Text = hasFavorite(gameInfo.Id) and "★" or "☆",
        TextColor3 = hasFavorite(gameInfo.Id) and COLORS.PurpleLight or COLORS.Muted,
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, card)
    corner(favoriteButton, 7)

    local openButton = create("TextButton", {
        Name = "OpenButton",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 12, 1, -9),
        Size = UDim2.new(1, -53, 0, 25),
        BackgroundColor3 = gameInfo.Enabled and COLORS.Purple or COLORS.Surface3,
        Text = gameInfo.Enabled and (currentLanguage == "VI" and "MỞ MENU  →" or "OPEN MENU  →")
            or (currentLanguage == "VI" and "SẮP RA MẮT" or "COMING SOON"),
        TextColor3 = gameInfo.Enabled and Color3.new(1, 1, 1) or COLORS.Muted,
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        AutoButtonColor = false,
        Active = gameInfo.Enabled,
        BorderSizePixel = 0,
    }, card)
    corner(openButton, 8)

    card.MouseEnter:Connect(function()
        tween(card, { BackgroundColor3 = Color3.fromRGB(36, 32, 51) }, 0.14)
        tween(cardStroke, { Transparency = 0.02, Color = COLORS.Purple }, 0.14)
    end)
    card.MouseLeave:Connect(function()
        tween(card, { BackgroundColor3 = COLORS.Surface2 }, 0.14)
        tween(cardStroke, { Transparency = 0.22, Color = COLORS.Border }, 0.14)
    end)

    favoriteButton.Activated:Connect(function()
        if hasFavorite(gameInfo.Id) then
            favoriteIds[gameInfo.Id] = nil
        else
            favoriteIds[gameInfo.Id] = true
        end
        local isFavorite = hasFavorite(gameInfo.Id)
        favoriteButton.Text = isFavorite and "★" or "☆"
        favoriteButton.TextColor3 = isFavorite and COLORS.PurpleLight or COLORS.Muted
        tween(favoriteButton, { BackgroundColor3 = isFavorite and COLORS.Border or COLORS.Surface3 }, 0.12)
        if rebuildFavorites then
            rebuildFavorites()
        end
    end)

    if gameInfo.Enabled then
        openButton.MouseEnter:Connect(function()
            tween(openButton, { BackgroundColor3 = COLORS.PurpleLight }, 0.12)
        end)
        openButton.MouseLeave:Connect(function()
            tween(openButton, { BackgroundColor3 = COLORS.Purple }, 0.12)
        end)

        openButton.Activated:Connect(function()
            -- Keep the original URL-loading pattern and target URL.
            -- The GUI hides while the selected game menu is being loaded.
            recentIds[#recentIds + 1] = gameInfo.Id
            for index = #recentIds - 1, 1, -1 do
                if recentIds[index] == gameInfo.Id then
                    table.remove(recentIds, index)
                end
            end
            if rebuildRecent then
                rebuildRecent()
            end

            openButton.Active = false
            openButton.Text = currentLanguage == "VI" and "ĐANG TẢI..." or "LOADING..."
            sidebarStatus.Text = currentLanguage == "VI" and "●  ĐANG MỞ MENU" or "●  OPENING MENU"
            screen.Enabled = false

            local success, err = pcall(function()
                loadstring(game:HttpGet(gameInfo.Url))()
            end)

            if not success then
                warn("[KATO HUB] Load failed:", err)
                screen.Enabled = true
                openButton.Active = true
                openButton.Text = currentLanguage == "VI" and "THỬ LẠI" or "TRY AGAIN"
                sidebarStatus.Text = currentLanguage == "VI" and "●  TẢI MENU THẤT BẠI" or "●  MENU LOAD FAILED"
            end
        end)
    end

    return card
end

local function makeCardGrid(parent, gridName)
    local holder = create("Frame", {
        Name = gridName,
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundTransparency = 1,
    }, parent)

    local layout = create("UIGridLayout", {
        CellSize = UDim2.new(0.5, -7, 0, 178),
        CellPadding = UDim2.fromOffset(12, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        holder.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 2)
    end)

    return holder, layout
end

-- UTILITIES CARDS
-- Utilities are catalog entries only. Url is stored/displayed as configuration;
-- this page does not execute arbitrary remote code.
local function makeUtilityCard(parent, utility, order)
    local card = create("Frame", {
        Name = utility.Id .. "Card",
        LayoutOrder = order or 1,
        BackgroundColor3 = COLORS.Surface2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, parent)
    corner(card, 14)
    local cardStroke = stroke(card, COLORS.Border, 0.22)
    local utilityUrl = utility.Url or ""

    local title = create("TextLabel", {
        Name = "Title",
        Position = UDim2.fromOffset(12, 14),
        Size = UDim2.new(1, -24, 0, 23),
        BackgroundTransparency = 1,
        Text = getGameText(utility, "Name"),
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local description = create("TextLabel", {
        Name = "Description",
        Position = UDim2.fromOffset(12, 43),
        Size = UDim2.new(1, -24, 0, 48),
        BackgroundTransparency = 1,
        Text = getGameText(utility, "Description"),
        TextColor3 = COLORS.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    }, card)

    local urlLabel = create("TextLabel", {
        Name = "URLLabel",
        Position = UDim2.fromOffset(12, 103),
        Size = UDim2.new(1, -24, 0, 13),
        BackgroundTransparency = 1,
        Text = "URL",
        TextColor3 = COLORS.PurpleLight,
        Font = Enum.Font.GothamBold,
        TextSize = 8,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local urlValue = create("TextLabel", {
        Name = "URLValue",
        Position = UDim2.fromOffset(12, 120),
        Size = UDim2.new(1, -24, 0, 34),
        BackgroundColor3 = COLORS.Surface3,
        BackgroundTransparency = 0.1,
        Text = utilityUrl ~= "" and utilityUrl or "(empty)",
        TextColor3 = utilityUrl ~= "" and COLORS.Text or COLORS.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, card)
    corner(urlValue, 7)
    create("UIPadding", {
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, urlValue)

    card.MouseEnter:Connect(function()
        tween(card, { BackgroundColor3 = Color3.fromRGB(36, 32, 51) }, 0.14)
        tween(cardStroke, { Transparency = 0.02, Color = COLORS.Purple }, 0.14)
    end)
    card.MouseLeave:Connect(function()
        tween(card, { BackgroundColor3 = COLORS.Surface2 }, 0.14)
        tween(cardStroke, { Transparency = 0.22, Color = COLORS.Border }, 0.14)
    end)

    return card
end

local function renderUtilityGrid(holder)
    if not holder then
        return
    end

    for _, child in ipairs(holder:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("Card$") then
            child:Destroy()
        end
    end

    for index, utility in ipairs(UTILITIES) do
        makeUtilityCard(holder, utility, index)
    end

    if utilitiesEmpty then
        utilitiesEmpty.Visible = (#UTILITIES == 0)
    end
end

local function renderGrid(holder, gameList)
    for _, child in ipairs(holder:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("Card$") then
            child:Destroy()
        end
    end

    for index, gameInfo in ipairs(gameList) do
        makeGameCard(holder, gameInfo, index)
    end
end

local function getFavoriteGames()
    local result = {}
    for _, gameInfo in ipairs(GAMES) do
        if hasFavorite(gameInfo.Id) then
            result[#result + 1] = gameInfo
        end
    end
    return result
end

local function getRecentGames()
    local result = {}
    local added = {}
    for index = #recentIds, 1, -1 do
        local gameInfo = getGameById(recentIds[index])
        if gameInfo and not added[gameInfo.Id] then
            result[#result + 1] = gameInfo
            added[gameInfo.Id] = true
        end
    end
    return result
end

rebuildFavorites = function()
    local list = getFavoriteGames()
    if favoritesGrid then
        renderGrid(favoritesGrid, list)
    end
    if favoritesEmpty then
        favoritesEmpty.Visible = (#list == 0)
    end
end

rebuildRecent = function()
    local list = getRecentGames()
    if recentGrid then
        renderGrid(recentGrid, list)
    end
    if recentEmpty then
        recentEmpty.Visible = (#list == 0)
    end
end

