local function makeTopButton(name, caption, xOffset, textColor)
    local button = create("TextButton", {
        Name = name,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOffset, 0.5, 0),
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = COLORS.Surface3,
        Text = caption,
        TextColor3 = textColor or COLORS.Text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 17,
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, topbar)
    corner(button, 9)

    button.MouseEnter:Connect(function()
        tween(button, { BackgroundColor3 = COLORS.Border }, 0.12)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundColor3 = COLORS.Surface3 }, 0.12)
    end)

    return button
end

