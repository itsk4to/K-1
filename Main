-- NAVIGATION
local NAV_ITEMS = {
    { Name = "Home", NameVi = "Trang chủ", Icon = "⌂" },
    { Name = "Game Selector", NameVi = "Chọn game", Icon = "▦" },
    { Name = "Favorites", NameVi = "Yêu thích", Icon = "☆" },
    { Name = "Recently Used", NameVi = "Gần đây", Icon = "◷" },
    { Name = "Utilities", NameVi = "Tiện ích", Icon = "✦" },
    { Name = "Settings", NameVi = "Cài đặt", Icon = "⚙" },
}

local function setActivePage(pageName)
    if not pageObjects[pageName] then
        return
    end

    currentPage = pageName
    for name, page in pairs(pageObjects) do
        page.Visible = name == pageName
        if page.Visible then
            page.CanvasPosition = Vector2.new(0, 0)
        end
    end

    for name, button in pairs(navButtons) do
        local selected = name == pageName
        tween(button, {
            BackgroundColor3 = selected and COLORS.Surface3 or COLORS.Surface,
        }, 0.12)

        local accent = button:FindFirstChild("Accent")
        local icon = button:FindFirstChild("Icon")
        local label = button:FindFirstChild("Label")

        if accent then accent.Visible = selected end
        if icon then icon.TextColor3 = selected and COLORS.PurpleLight or COLORS.Muted end
        if label then label.TextColor3 = selected and COLORS.Text or COLORS.Muted end
    end
end

for index, item in ipairs(NAV_ITEMS) do
    local button = create("TextButton", {
        Name = item.Name:gsub("%s+", ""),
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = COLORS.Surface,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        LayoutOrder = index,
    }, navHolder)
    corner(button, 10)

    local accent = create("Frame", {
        Name = "Accent",
        Position = UDim2.fromOffset(0, 8),
        Size = UDim2.new(0, 3, 1, -16),
        BackgroundColor3 = COLORS.PurpleLight,
        BorderSizePixel = 0,
        Visible = false,
    }, button)
    corner(accent, 2)

    local icon = create("TextLabel", {
        Name = "Icon",
        Position = UDim2.fromOffset(7, 0),
        Size = UDim2.fromOffset(34, 42),
        BackgroundTransparency = 1,
        Text = item.Icon,
        TextColor3 = COLORS.Muted,
        Font = Enum.Font.GothamBold,
        TextSize = 17,
    }, button)

    local label = create("TextLabel", {
        Name = "Label",
        Position = UDim2.fromOffset(43, 0),
        Size = UDim2.new(1, -48, 1, 0),
        BackgroundTransparency = 1,
        Text = currentLanguage == "VI" and item.NameVi or item.Name,
        TextColor3 = COLORS.Muted,
        Font = Enum.Font.GothamSemibold,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, button)

    localizedObjects[#localizedObjects + 1] = {
        Object = label,
        English = item.Name,
        Vietnamese = item.NameVi,
        Property = "Text",
    }

    button.MouseEnter:Connect(function()
        if currentPage ~= item.Name then
            tween(button, { BackgroundColor3 = COLORS.Surface2 }, 0.1)
        end
    end)
    button.MouseLeave:Connect(function()
        tween(button, {
            BackgroundColor3 = currentPage == item.Name and COLORS.Surface3 or COLORS.Surface,
        }, 0.1)
    end)
    button.Activated:Connect(function()
        setActivePage(item.Name)
    end)

    navButtons[item.Name] = button
end

-- RESPONSIVE LAYOUT
local function updateGridLayout(grid, layout)
    if not grid or not layout then
        return
    end

    if isMobile then
        layout.CellSize = UDim2.new(1, 0, 0, 178)
        layout.CellPadding = UDim2.fromOffset(0, 10)
    else
        layout.CellSize = UDim2.new(0.5, -7, 0, 178)
        layout.CellPadding = UDim2.fromOffset(12, 10)
    end

    task.defer(function()
        if grid and grid.Parent then
            grid.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 2)
        end
    end)
end

local function refreshLayout()
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1000, 700)
    isMobile = viewport.X < 720

    local width
    local height
    if isMobile then
        width = math.max(230, math.min(viewport.X - 20, 430))
        height = math.max(300, math.min(viewport.Y - 30, 620))
    else
        width = math.max(560, math.min(viewport.X - 48, 900))
        height = math.max(420, math.min(viewport.Y - 48, 660))
    end

    normalWindowSize = Vector2.new(width, height)
    if isMinimized then
        return
    end

    window.AnchorPoint = Vector2.new(0.5, 0.5)
    window.Position = UDim2.fromScale(0.5, 0.5)
    window.Size = UDim2.fromOffset(width, height)

    local topbarHeight = isMobile and 54 or 60
    topbar.Size = UDim2.new(1, 0, 0, topbarHeight)
    body.Position = UDim2.fromOffset(0, topbarHeight)
    body.Size = UDim2.new(1, 0, 1, -topbarHeight)

    if isMobile then
        sidebar.Size = UDim2.new(0, 49, 1, 0)
        pageHost.Position = UDim2.new(0, 49, 0, 0)
        pageHost.Size = UDim2.new(1, -49, 1, 0)

        sidebarTitle.Visible = false
        sidebarStatus.Visible = false
        brandSub.Visible = false
        brandName.Position = UDim2.fromOffset(57, 15)
        brandName.Size = UDim2.fromOffset(110, 22)
        brandName.TextSize = 14
        logo.Position = UDim2.fromOffset(11, 9)
        logo.Size = UDim2.fromOffset(34, 34)
        versionLabel.Visible = false

        for _, button in pairs(navButtons) do
            button.Size = UDim2.new(1, -8, 0, 36)
            local navLabel = button:FindFirstChild("Label")
            local navIcon = button:FindFirstChild("Icon")
            if navLabel then navLabel.Visible = false end
            if navIcon then
                navIcon.Position = UDim2.fromOffset(0, 0)
                navIcon.Size = UDim2.fromScale(1, 1)
                navIcon.TextSize = 16
            end
        end
        navHolder.Position = UDim2.fromOffset(4, 13)
        navHolder.Size = UDim2.new(1, -8, 0, 245)
        navLayout.Padding = UDim.new(0, 5)
    else
        sidebar.Size = UDim2.new(0, 180, 1, 0)
        pageHost.Position = UDim2.new(0, 180, 0, 0)
        pageHost.Size = UDim2.new(1, -180, 1, 0)

        sidebarTitle.Visible = true
        sidebarStatus.Visible = true
        brandSub.Visible = true
        brandName.Position = UDim2.fromOffset(64, 10)
        brandName.Size = UDim2.fromOffset(190, 22)
        brandName.TextSize = 17
        logo.Position = UDim2.fromOffset(17, 12)
        logo.Size = UDim2.fromOffset(36, 36)
        versionLabel.Visible = true

        for _, button in pairs(navButtons) do
            button.Size = UDim2.new(1, 0, 0, 42)
            local navLabel = button:FindFirstChild("Label")
            local navIcon = button:FindFirstChild("Icon")
            if navLabel then navLabel.Visible = true end
            if navIcon then
                navIcon.Position = UDim2.fromOffset(7, 0)
                navIcon.Size = UDim2.fromOffset(34, 42)
                navIcon.TextSize = 17
            end
        end
        navHolder.Position = UDim2.fromOffset(10, 48)
        navHolder.Size = UDim2.new(1, -20, 0, 300)
        navLayout.Padding = UDim.new(0, 7)
    end

    for _, page in pairs(pageObjects) do
        local padding = page:FindFirstChildOfClass("UIPadding")
        if padding then
            local side = isMobile and 12 or 20
            padding.PaddingLeft = UDim.new(0, side)
            padding.PaddingRight = UDim.new(0, side)
            padding.PaddingTop = UDim.new(0, isMobile and 14 or 20)
            padding.PaddingBottom = UDim.new(0, 22)
        end
    end

    updateGridLayout(homeGrid, homeGridLayout)
    updateGridLayout(selectorGrid, selectorGridLayout)
    updateGridLayout(favoritesGrid, favoritesGridLayout)
    updateGridLayout(recentGrid, recentGridLayout)
    updateGridLayout(utilityGrid, utilityGridLayout)
end

-- DRAG WINDOW (topbar only; buttons are excluded)
local function pointInside(guiObject, point)
    local position = guiObject.AbsolutePosition
    local size = guiObject.AbsoluteSize
    return point.X >= position.X
        and point.X <= position.X + size.X
        and point.Y >= position.Y
        and point.Y <= position.Y + size.Y
end

topbar.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if pointInside(minimizeButton, input.Position) or pointInside(closeButton, input.Position) then
        return
    end

    dragging = true
    dragStart = input.Position
    dragStartPosition = window.Position

    input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End then
            dragging = false
        end
    end)
end)

inputChangedConnection = UserInputService.InputChanged:Connect(function(input)
    if not dragging or isMinimized then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        window.Position = UDim2.new(
            dragStartPosition.X.Scale,
            dragStartPosition.X.Offset + delta.X,
            dragStartPosition.Y.Scale,
            dragStartPosition.Y.Offset + delta.Y
        )
    end
end)

-- EXPLORE BUTTON
exploreButton.Activated:Connect(function()
    setActivePage("Game Selector")
end)

-- LANGUAGE TOGGLE
languageButton.Activated:Connect(function()
    currentLanguage = currentLanguage == "EN" and "VI" or "EN"
    languageButton.Text = currentLanguage == "EN" and "ENGLISH  ▾" or "TIẾNG VIỆT  ▾"
    applyLanguage()

    -- Update the game-card text without rebuilding the Home / Selector pages.
    for _, grid in ipairs({ homeGrid, selectorGrid }) do
        if grid then
            for _, gameInfo in ipairs(GAMES) do
                local card = grid:FindFirstChild(gameInfo.Id .. "Card")
                if card then
                    local category = card:FindFirstChild("Category")
                    local title = card:FindFirstChild("Title")
                    local description = card:FindFirstChild("Description")
                    local openButton = card:FindFirstChild("OpenButton")

                    if category then category.Text = getGameText(gameInfo, "Category") end
                    if title then title.Text = getGameText(gameInfo, "Name") end
                    if description then description.Text = getGameText(gameInfo, "Description") end
                    if openButton then
                        openButton.Text = gameInfo.Enabled
                            and (currentLanguage == "VI" and "MỞ MENU  →" or "OPEN MENU  →")
                            or (currentLanguage == "VI" and "SẮP RA MẮT" or "COMING SOON")
                    end
                end
            end
        end
    end

    -- Favorites / Recently Used are rebuilt so their card text matches the language.
    rebuildFavorites()
    rebuildRecent()
    renderUtilityGrid(utilityGrid)
end)

-- MINIMIZE / CLOSE
minimizeButton.Activated:Connect(function()
    isMinimized = not isMinimized
    body.Visible = not isMinimized
    overlay.BackgroundTransparency = isMinimized and 1 or 0.38

    if isMinimized then
        window.AnchorPoint = Vector2.new(1, 1)
        window.Position = UDim2.new(1, -10, 1, -10)
        window.Size = UDim2.new(0, math.min(300, normalWindowSize.X), 0, 54)
        minimizeButton.Text = "□"
        versionLabel.Visible = false
        brandSub.Visible = false
    else
        minimizeButton.Text = "−"
        refreshLayout()
        brandSub.Visible = not isMobile
        versionLabel.Visible = not isMobile
    end
end)

closeButton.Activated:Connect(function()
    screen.Enabled = false
end)

-- KEYBOARD TOGGLE (RIGHT CTRL / RIGHT SHIFT)
inputBeganConnection = UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightControl
        or input.KeyCode == Enum.KeyCode.RightShift then
        screen.Enabled = not screen.Enabled
    end
end)

-- CAMERA / VIEWPORT CONNECTIONS
local function bindCamera(camera)
    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end

    if camera then
        cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshLayout)
    end
    refreshLayout()
end

bindCamera(Workspace.CurrentCamera)
cameraChangedConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    bindCamera(Workspace.CurrentCamera)
end)

-- INITIAL PAGE + FIRST RENDER
setActivePage("Home")
rebuildFavorites()
rebuildRecent()
refreshLayout()

-- STARTUP INTRO
local intro = create("Frame", {
    Name = "KATOIntro",
    Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = COLORS.Background,
    BackgroundTransparency = 0.04,
    BorderSizePixel = 0,
    ZIndex = 100,
}, screen)

local introLogo = create("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.42),
    Size = UDim2.fromOffset(62, 62),
    BackgroundColor3 = COLORS.Purple,
    BorderSizePixel = 0,
    ZIndex = 101,
}, intro)
corner(introLogo, 18)
create("UIGradient", {
    Color = ColorSequence.new(COLORS.PurpleLight, COLORS.Purple),
    Rotation = 45,
}, introLogo)
create("TextLabel", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Text = "K",
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBlack,
    TextSize = 38,
    ZIndex = 102,
}, introLogo)

local introTitle = create("TextLabel", {
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.fromScale(0.5, 0.52),
    Size = UDim2.new(0.8, 0, 0, 34),
    BackgroundTransparency = 1,
    Text = "KATO HUB",
    TextColor3 = COLORS.Text,
    Font = Enum.Font.GothamBlack,
    TextSize = 25,
    ZIndex = 101,
}, intro)

local introSubtitle = create("TextLabel", {
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.fromScale(0.5, 0.59),
    Size = UDim2.new(0.85, 0, 0, 22),
    BackgroundTransparency = 1,
    Text = "UNIVERSAL GAME HUB",
    TextColor3 = COLORS.PurpleLight,
    Font = Enum.Font.GothamSemibold,
    TextSize = 10,
    ZIndex = 101,
}, intro)

-- INTRO FADE + WINDOW POP-IN
-- Use task.spawn so the UI initialization finishes before the animation starts.
task.spawn(function()
    task.wait(0.65)
    local fadeInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    tween(intro, { BackgroundTransparency = 1 }, 0.35, Enum.EasingStyle.Quad)
    tween(introLogo, { BackgroundTransparency = 1 }, 0.35, Enum.EasingStyle.Quad)
    tween(introTitle, { TextTransparency = 1 }, 0.35, Enum.EasingStyle.Quad)
    tween(introSubtitle, { TextTransparency = 1 }, 0.35, Enum.EasingStyle.Quad)
    task.wait(0.38)

    if intro and intro.Parent then
        intro:Destroy()
    end

    if not screen.Parent then
        return
    end

    window.Visible = true
    local targetSize = window.Size
    window.Size = UDim2.fromOffset(targetSize.X.Offset * 0.94, targetSize.Y.Offset * 0.94)
    tween(window, { Size = targetSize }, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end)

-- CLEAN UP CONNECTIONS IF THE GUI IS DESTROYED
screen.Destroying:Connect(function()
    if cameraConnection then cameraConnection:Disconnect() end
    if cameraChangedConnection then cameraChangedConnection:Disconnect() end
    if inputBeganConnection then inputBeganConnection:Disconnect() end
    if inputChangedConnection then inputChangedConnection:Disconnect() end
end)

print("[KATO HUB] Main Menu v2.2 with Utilities loaded successfully")
