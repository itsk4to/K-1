--[[
KATO HUB - MAIN MENU (Executor Version)
Ấn TSB → loadstring Game Menu 1 từ GitHub
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local COLORS = {
	Background = Color3.fromRGB(13, 12, 19),
	Surface = Color3.fromRGB(22, 20, 31),
	Surface2 = Color3.fromRGB(30, 27, 42),
	Surface3 = Color3.fromRGB(39, 35, 54),
	Purple = Color3.fromRGB(137, 92, 246),
	PurpleLight = Color3.fromRGB(177, 139, 255),
	Text = Color3.fromRGB(245, 242, 252),
	Muted = Color3.fromRGB(160, 153, 176),
	Border = Color3.fromRGB(66, 58, 86),
	Green = Color3.fromRGB(91, 210, 153),
}

local GAMES = {
	{
		Id = "TSB",
		Name = "The Strongest Battlegrounds",
		ShortName = "TSB",
		Category = "GAME MENU 1",
		Description = "Open the TSB interface.",
		Image = "rbxthumb://type=GameIcon&id=3808081382&w=512&h=512",
		Enabled = true,
		Url = "https://raw.githubusercontent.com/itsk4to/K-1/main/Game%20Menu%201"
	},
	{
		Id = "MORE",
		Name = "More Games",
		ShortName = "+",
		Category = "COMING SOON",
		Description = "Additional game menus can be added later.",
		Image = "",
		Enabled = false,
	},
}

local old = playerGui:FindFirstChild("KATO_HUB_MAIN")
if old then old:Destroy() end

local function create(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do obj[k] = v end
	obj.Parent = parent
	return obj
end

local function corner(p, r)
	return create("UICorner", {CornerRadius = UDim.new(0, r or 12)}, p)
end

local function stroke(p, color, t)
	return create("UIStroke", {
		Color = color or COLORS.Border,
		Transparency = t or 0,
		Thickness = 1
	}, p)
end

local screen = create("ScreenGui", {
	Name = "KATO_HUB_MAIN",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 50,
}, playerGui)

local overlay = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.4,
	BorderSizePixel = 0,
}, screen)

local window = create("Frame", {
	Name = "MainWindow",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(820, 540),
	BackgroundColor3 = COLORS.Background,
	BorderSizePixel = 0,
	ClipsDescendants = true,
}, overlay)
corner(window, 16)
stroke(window, COLORS.Border, 0.2)

-- Topbar
local topbar = create("Frame", {
	Size = UDim2.new(1, 0, 0, 58),
	BackgroundColor3 = COLORS.Surface,
	BorderSizePixel = 0,
}, window)

local logo = create("Frame", {
	Position = UDim2.fromOffset(16, 11),
	Size = UDim2.fromOffset(36, 36),
	BackgroundColor3 = COLORS.Purple,
	BorderSizePixel = 0,
}, topbar)
corner(logo, 10)
create("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Text = "K",
	TextColor3 = Color3.new(1,1,1),
	Font = Enum.Font.GothamBold,
	TextSize = 20,
}, logo)

create("TextLabel", {
	Position = UDim2.fromOffset(62, 10),
	Size = UDim2.fromOffset(200, 22),
	BackgroundTransparency = 1,
	Text = "KATO HUB",
	TextColor3 = COLORS.Text,
	Font = Enum.Font.GothamBold,
	TextSize = 16,
	TextXAlignment = Enum.TextXAlignment.Left,
}, topbar)

create("TextLabel", {
	Position = UDim2.fromOffset(63, 32),
	Size = UDim2.fromOffset(200, 16),
	BackgroundTransparency = 1,
	Text = "UNIVERSAL GAME HUB",
	TextColor3 = COLORS.Muted,
	Font = Enum.Font.GothamMedium,
	TextSize = 9,
	TextXAlignment = Enum.TextXAlignment.Left,
}, topbar)

local closeBtn = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -14, 0.5, 0),
	Size = UDim2.fromOffset(30, 30),
	BackgroundColor3 = COLORS.Surface3,
	Text = "×",
	TextColor3 = Color3.fromRGB(255, 130, 140),
	Font = Enum.Font.GothamBold,
	TextSize = 18,
	AutoButtonColor = false,
	BorderSizePixel = 0,
}, topbar)
corner(closeBtn, 8)
closeBtn.Activated:Connect(function()
	screen:Destroy()
end)

-- Body
local body = create("Frame", {
	Position = UDim2.fromOffset(0, 58),
	Size = UDim2.new(1, 0, 1, -58),
	BackgroundTransparency = 1,
}, window)

local scroll = create("ScrollingFrame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 4,
	ScrollBarImageColor3 = COLORS.Purple,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
}, body)

create("UIPadding", {
	PaddingTop = UDim.new(0, 18),
	PaddingLeft = UDim.new(0, 18),
	PaddingRight = UDim.new(0, 18),
	PaddingBottom = UDim.new(0, 18),
}, scroll)

create("UIListLayout", {
	Padding = UDim.new(0, 14),
	SortOrder = Enum.SortOrder.LayoutOrder,
}, scroll)

create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 26),
	BackgroundTransparency = 1,
	Text = "SUPPORTED GAMES",
	TextColor3 = COLORS.Text,
	Font = Enum.Font.GothamBold,
	TextSize = 16,
	TextXAlignment = Enum.TextXAlignment.Left,
}, scroll)

-- Game Card
local function makeCard(game)
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundColor3 = COLORS.Surface2,
		BorderSizePixel = 0,
	}, scroll)
	corner(card, 12)
	stroke(card, COLORS.Border, 0.3)

	if game.Image and game.Image \~= "" then
		create("ImageLabel", {
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(86, 86),
			BackgroundTransparency = 1,
			Image = game.Image,
			ScaleType = Enum.ScaleType.Crop,
		}, card)
	else
		local icon = create("Frame", {
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(86, 86),
			BackgroundColor3 = COLORS.Purple,
			BorderSizePixel = 0,
		}, card)
		corner(icon, 10)
		create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = game.ShortName,
			TextColor3 = Color3.new(1,1,1),
			Font = Enum.Font.GothamBlack,
			TextSize = 22,
		}, icon)
	end

	create("TextLabel", {
		Position = UDim2.fromOffset(112, 14),
		Size = UDim2.new(1, -130, 0, 20),
		BackgroundTransparency = 1,
		Text = game.Name,
		TextColor3 = COLORS.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	create("TextLabel", {
		Position = UDim2.fromOffset(112, 36),
		Size = UDim2.new(1, -130, 0, 18),
		BackgroundTransparency = 1,
		Text = game.Description,
		TextColor3 = COLORS.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local btn = create("TextButton", {
		Position = UDim2.fromOffset(112, 68),
		Size = UDim2.fromOffset(130, 28),
		BackgroundColor3 = game.Enabled and COLORS.Purple or COLORS.Surface3,
		Text = game.Enabled and "OPEN MENU →" or "COMING SOON",
		TextColor3 = game.Enabled and Color3.new(1,1,1) or COLORS.Muted,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Active = game.Enabled,
	}, card)
	corner(btn, 8)

	if game.Enabled then
		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.PurpleLight}):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = COLORS.Purple}):Play()
		end)

		btn.Activated:Connect(function()
			screen.Enabled = false

			local success, err = pcall(function()
				loadstring(game:HttpGet(game.Url))()
			end)

			if not success then
				warn("[KATO HUB] Load failed:", err)
				screen.Enabled = true
			end
		end)
	end
end

for _, g in ipairs(GAMES) do
	makeCard(g)
end

-- Keybind
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.RightShift then
		screen.Enabled = not screen.Enabled
	end
end)

print("[KATO HUB] Main Menu loaded (Executor)")
