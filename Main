selectorSearch:GetPropertyChangedSignal("Text"):Connect(function()
    local query = string.lower(selectorSearch.Text)
    for _, child in ipairs(selectorGrid:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("Card$") then
            local gameId = child.Name:gsub("Card$", "")
            local gameInfo = getGameById(gameId)
            if gameInfo then
                local searchable = string.lower(
                    gameInfo.Name .. " " .. (gameInfo.NameVi or "") .. " " ..
                    gameInfo.Id .. " " .. gameInfo.Category .. " " .. (gameInfo.CategoryVi or "")
                )
                child.Visible = query == "" or string.find(searchable, query, 1, true) ~= nil
            end
        end
    end
end)

