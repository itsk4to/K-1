-- PAGE HELPERS
local function makePage(pageName)
    local page = create("ScrollingFrame", {
        Name = pageName:gsub("%s+", "") .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.Purple,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, pageHost)

    create("UIPadding", {
        PaddingLeft = UDim.new(0, 20),
        PaddingRight = UDim.new(0, 20),
        PaddingTop = UDim.new(0, 20),
        PaddingBottom = UDim.new(0, 24),
    }, page)

    create("UIListLayout", {
        Padding = UDim.new(0, 13),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    pageObjects[pageName] = page
    return page
end

local function makePageHeader(parent, englishTitle, vietnameseTitle, englishSubtitle, vietnameseSubtitle)
    local title = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Text = englishTitle,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 23,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    localize(title, englishTitle, vietnameseTitle)

    local subtitle = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        Text = englishSubtitle,
        TextColor3 = COLORS.Muted,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    localize(subtitle, englishSubtitle, vietnameseSubtitle)
end

local function makeSectionTitle(parent, englishTitle, vietnameseTitle, englishNote, vietnameseNote)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 23),
        BackgroundTransparency = 1,
    }, parent)

    local title = create("TextLabel", {
        Size = UDim2.new(0.72, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = englishTitle,
        TextColor3 = COLORS.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    localize(title, englishTitle, vietnameseTitle)

    if englishNote then
        local note = create("TextLabel", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.new(0.28, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = englishNote,
            TextColor3 = COLORS.Muted,
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, row)
        localize(note, englishNote, vietnameseNote or englishNote)
    end
    return row
end

