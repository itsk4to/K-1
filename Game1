-- DRAG WINDOW (mouse + touch)
local dragging = false
local dragInput = nil
local dragStart = nil
local dragStartPosition = nil

 topbar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        dragStartPosition = window.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragInput = nil
            end
        end)
    end
end)

topbar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

local dragConnection = UserInputService.InputChanged:Connect(function(input)
    if dragging and dragInput and input == dragInput then
        local delta = input.Position - dragStart
        local viewport = getViewport()
        local halfW = window.AbsoluteSize.X / 2
        local halfH = window.AbsoluteSize.Y / 2
        local xLimit = math.max(0, viewport.X / 2 - halfW)
        local yLimit = math.max(0, viewport.Y / 2 - halfH)
        local x = math.clamp(dragStartPosition.X.Offset + delta.X, -xLimit, xLimit)
        local y = math.clamp(dragStartPosition.Y.Offset + delta.Y, -yLimit, yLimit)
        window.Position = UDim2.new(0.5, x, 0.5, y)
    end
end)

-- CAMERA / RESIZE CONNECTIONS
local viewportConnection
local cameraChangedConnection

local function bindViewport(camera)
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end
    if camera then
        viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            applyResponsiveLayout()
        end)
    end
end

bindViewport(Workspace.CurrentCamera)
cameraChangedConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    bindViewport(Workspace.CurrentCamera)
    applyResponsiveLayout()
end)

-- GLOBAL INPUT: configurable toggle key
local inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if waitingForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
            selectedKey = input.KeyCode
            CONFIG.TOGGLE_KEY = selectedKey
            waitingForKey = false
            setStatus(tr("Toggle key updated."), C.Green)
            if activeTab == "Settings" and screen.Parent then
                renderTab("Settings")
            end
        end
        return
    end

    if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if input.KeyCode == selectedKey and isOpen then
        if isMinimized then
            restoreMenu()
        else
            shade.Visible = not shade.Visible
            if not shade.Visible then
                window.Visible = false
            else
                window.Visible = true
            end
        end
    end
end)

-- SINGLE PERFORMANCE LOOP (prevents duplicate loops when Settings is reopened)
local elapsed = 0
local frameCount = 0
local frameTimeTotal = 0
local performanceConnection = RunService.RenderStepped:Connect(function(dt)
    elapsed = elapsed + dt
    frameCount = frameCount + 1
    frameTimeTotal = frameTimeTotal + dt * 1000

    if elapsed >= 1 then
        fpsValue = math.floor(frameCount / elapsed + 0.5)
        frameTimeValue = frameCount > 0 and (frameTimeTotal / frameCount) or 0
        pingValue = getPing()
        hudText.Text = "FPS  " .. tostring(fpsValue) .. "     PING  " .. tostring(pingValue)

        if settingsRefs then
            if settingsRefs.FPS and settingsRefs.FPS.Parent then
                settingsRefs.FPS.Text = "FPS: " .. tostring(fpsValue)
            end
            if settingsRefs.Ping and settingsRefs.Ping.Parent then
                settingsRefs.Ping.Text = "Ping: " .. tostring(pingValue)
            end
            if settingsRefs.Frame and settingsRefs.Frame.Parent then
                settingsRefs.Frame.Text = tr("Frame time") .. string.format(": %.1f ms", frameTimeValue)
            end
            if settingsRefs.Players and settingsRefs.Players.Parent then
                settingsRefs.Players.Text = tr("Players in this server") .. ": " .. tostring(#Players:GetPlayers())
            end
            if settingsRefs.Uptime and settingsRefs.Uptime.Parent then
                settingsRefs.Uptime.Text = tr("Session uptime") .. ": " .. formatUptime(os.clock() - bootClock)
            end
        end

        elapsed = 0
        frameCount = 0
        frameTimeTotal = 0
    end
end)

-- INITIALIZE
applyResponsiveLayout()
renderTab("Tech")

local function openMenu()
    isOpen = true
    isMinimized = false
    shade.Visible = true
    restoreButton.Visible = false
    window.Visible = false
    window.Position = UDim2.fromScale(0.5, 0.5)
    window.BackgroundTransparency = panelTransparency
    applyResponsiveLayout()

    task.spawn(function()
        playIntro()
        if not screen.Parent or not isOpen then return end
        window.Visible = true
        applyResponsiveLayout()
        local targetSize = window.Size
        window.Size = UDim2.fromOffset(targetSize.X.Offset * 0.96, targetSize.Y.Offset * 0.96)
        animate(window, { Size = targetSize }, 0.22, Enum.EasingStyle.Back)
    end)
end

openMenu()

-- CLEANUP
screen.Destroying:Connect(function()
    isOpen = false
    if inputConnection then inputConnection:Disconnect() end
    if dragConnection then dragConnection:Disconnect() end
    if performanceConnection then performanceConnection:Disconnect() end
    if viewportConnection then viewportConnection:Disconnect() end
    if cameraChangedConnection then cameraChangedConnection:Disconnect() end
end)

print("[KATO HUB TSB] v" .. CONFIG.VERSION .. " loaded successfully")
