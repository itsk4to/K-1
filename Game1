-- SCRIPT TEMPLATE RUNNER
-- URLs are intentionally blank in SCRIPT_PAGES until configured by the owner.
local function runScriptTemplate(entry, actionButton)
    local url = trim(entry.Url)
    if url == "" then
        actionButton.Text = tr("URL NOT SET")
        actionButton.BackgroundColor3 = C.Surface3
        setStatus(tr("Script URL is empty. Add it to SCRIPT_PAGES first."), C.Amber)
        task.delay(1.4, function()
            if actionButton.Parent then
                actionButton.Text = tr("LOADSTRING")
                actionButton.BackgroundColor3 = C.Purple
            end
        end)
        return
    end

    actionButton.Active = false
    actionButton.Text = tr("LOADING...")
    task.spawn(function()
        local ok, err = pcall(function()
            local source = game:HttpGet(url)
            local chunk, compileError = loadstring(source)
            if not chunk then
                error(compileError or "Unable to compile script")
            end
            chunk()
        end)

        if not actionButton.Parent then return end
        actionButton.Active = true
        if ok then
            actionButton.Text = tr("EXECUTED")
            actionButton.BackgroundColor3 = C.Green
            setStatus(entry.Name .. " • " .. tr("EXECUTED"), C.Green)
        else
            actionButton.Text = tr("FAILED")
            actionButton.BackgroundColor3 = C.Red
            setStatus(entry.Name .. " • " .. tr("FAILED"), C.Red)
            warn("[KATO HUB TSB] Script error:", entry.Name, err)
        end

        task.delay(1.5, function()
            if actionButton.Parent then
                actionButton.Text = tr("LOADSTRING")
                actionButton.BackgroundColor3 = C.Purple
            end
        end)
    end)
end

