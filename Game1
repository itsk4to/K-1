local function clear()
	for _, c in ipairs(scroll:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

local function title(text, desc)
	local h = make("Frame", {
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
	}, scroll)
	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, h)
	make("TextLabel", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = desc or "",
		TextColor3 = C.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, h)
end

local function card(text, desc)
	local f = make("Frame", {
		Size = UDim2.new(1, 0, 0, 72),
		BackgroundColor3 = C.Surface,
		BorderSizePixel = 0,
	}, scroll)
	round(f, 10)
	outline(f)
	make("TextLabel", {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 24),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
	make("TextLabel", {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -28, 0, 22),
		BackgroundTransparency = 1,
		Text = desc,
		TextColor3 = C.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, f)
end

local function render(tab)
	clear()
	title("KATO HUB / " .. tab, "TSB Control Panel")

	if tab == "Combat" then
		card("Combat Settings", "Tích hợp chức năng combat tại đây.")
		card("Auto Features", "Các nút chức năng sẽ được thêm sau.")
	elseif tab == "Moveset" then
		card("Moveset", "Quản lý bộ kỹ năng.")
	elseif tab == "Visuals" then
		card("Visuals", "Tùy chỉnh giao diện.")
	elseif tab == "Misc" then
		card("Miscellaneous", "Các tiện ích khác.")
	elseif tab == "Settings" then
		card("Version", "KATO HUB TSB " .. CONFIG.VERSION)
		card("Toggle Key", "RightShift để ẩn/hiện menu")
	end
end

local tabs = {"Combat", "Moveset", "Visuals", "Misc", "Settings"}
for i, name in ipairs(tabs) do
	local btn = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = C.Surface2,
		Text = name,
		TextColor3 = C.Text,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		LayoutOrder = i,
	}, sidebar)
	round(btn, 8)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = C.Purple}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = C.Surface2}):Play()
	end)
	btn.Activated:Connect(function()
		render(name)
	end)
end

render("Combat")

-- Toggle
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == CONFIG.TOGGLE_KEY then
		screen.Enabled = not screen.Enabled
	end
end)

