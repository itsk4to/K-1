-- RESPONSIVE LAYOUT
local function getViewport()
    local camera = Workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1000, 700)
end

local function clampWindowToViewport()
    local viewport = getViewport()
    local halfWidth = window.AbsoluteSize.X / 2
    local halfHeight = window.AbsoluteSize.Y / 2
    local xMin = -viewport.X / 2 + math.min(halfWidth, viewport.X / 2)
    local xMax = viewport.X / 2 - math.min(halfWidth, viewport.X / 2)
    local yMin = -viewport.Y / 2 + math.min(halfHeight, viewport.Y / 2)
    local yMax = viewport.Y / 2 - math.min(halfHeight, viewport.Y / 2)
    local x = math.clamp(window.Position.X.Offset, xMin, xMax)
    local y = math.clamp(window.Position.Y.Offset, yMin, yMax)
    window.Position = UDim2.new(0.5, x, 0.5, y)
end

applyResponsiveLayout = function()
    local viewport = getViewport()
    local mobile = viewport.X < 720
    isMobileLayout = mobile

    local width, height
    if mobile then
        width = math.max(250, math.min(viewport.X - 16, 500))
        height = math.max(300, math.min(viewport.Y - 24, 720))
    else
        width = math.max(560, math.min(viewport.X - 60, 900))
        height = math.max(390, math.min(viewport.Y - 60, 620))
    end

    width = math.floor(width * menuScale)
    height = math.floor(height * menuScale)
    width = math.min(width, math.max(240, viewport.X - 12))
    height = math.min(height, math.max(280, viewport.Y - 12))

    window.Size = UDim2.fromOffset(width, height)

    local topHeight = mobile and 52 or 58
    topbar.Size = UDim2.new(1, 0, 0, topHeight)
    body.Position = UDim2.fromOffset(0, topHeight)
    body.Size = UDim2.new(1, 0, 1, -topHeight)

    local sideWidth = mobile and 52 or 176
    sidebar.Size = UDim2.new(0, sideWidth, 1, 0)
    sidebarCaption.Visible = not mobile
    navHolder.Position = UDim2.fromOffset(mobile and 5 or 9, mobile and 10 or 42)
    navHolder.Size = UDim2.new(1, mobile and -10 or -18, 0, 280)
    content.Position = UDim2.new(0, sideWidth, 0, 0)
    content.Size = UDim2.new(1, -sideWidth, 1, -22)
    statusBar.Position = UDim2.new(0, sideWidth, 1, -22)
    statusBar.Size = UDim2.new(1, -sideWidth, 0, 22)

    titleLabel.TextSize = mobile and 13 or 15
    subtitleLabel.Visible = not mobile
    minimizeButton.Position = UDim2.new(1, -54, 0.5, 0)
    closeButton.Position = UDim2.new(1, -14, 0.5, 0)

    updateNavigation()
    clampWindowToViewport()
end

