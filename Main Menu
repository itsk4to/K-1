local function makeGameCard(parent, game)
	local card = create("Frame", {
		Name = game.Id .. "Card",
		BackgroundColor3 = COLORS.Surface2,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, parent)
	corner(card, 14)
	stroke(card, COLORS.Border, 0.2)

	local art = create("Frame", {
		Name = "Artwork",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.new(1, -16, 0, 92),
		BackgroundColor3 = Color3.fromRGB(54, 40, 86),
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, card)
	corner(art, 10)
	create("UIGradient", {
		Color = ColorSequence.new(COLORS.Purple, Color3.fromRGB(42, 34, 62)),
		Rotation = 20,
	}, art)
	if game.Image and game.Image \~= "" then
		create("ImageLabel", {
			Name = "GameImage",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = game.Image,
			ScaleType = Enum.ScaleType.Crop,
		}, art)
	else
		create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = game.ShortName,
			TextColor3 = Color3.fromRGB(241, 232, 255),
			Font = Enum.Font.GothamBlack,
			TextSize = 30,
		}, art)
	end

	create("TextLabel", {
		Position = UDim2.fromOffset(12, 108),
		Size = UDim2.new(1, -24, 0, 13),
		BackgroundTransparency = 1,
		Text = game.Category,
		TextColor3 = COLORS.PurpleLight,
		Font = Enum.Font.GothamBold,
		TextSize = 8,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	create("TextLabel", {
		Position = UDim2.fromOffset(12, 122),
		Size = UDim2.new(1, -24, 0, 21),
		BackgroundTransparency = 1,
		Text = game.Name,
		TextColor3 = COLORS.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	create("TextLabel", {
		Position = UDim2.fromOffset(12, 147),
		Size = UDim2.new(1, -24, 0, 22),
		BackgroundTransparency = 1,
		Text = game.Description,
		TextColor3 = COLORS.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 9,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, card)

	local openButton = create("TextButton", {
		Name = "OpenButton",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -9),
		Size = UDim2.new(1, -24, 0, 25),
		BackgroundColor3 = game.Enabled and COLORS.Purple or COLORS.Surface3,
		Text = game.Enabled and "OPEN MENU  →" or "COMING SOON",
		TextColor3 = game.Enabled and Color3.new(1, 1, 1) or COLORS.Muted,
		Font = Enum.Font.GothamBold,
		TextSize = 9,
		AutoButtonColor = false,
		Active = game.Enabled,
		BorderSizePixel = 0,
	}, card)
	corner(openButton, 8)

	if game.Enabled then
		openButton.MouseEnter:Connect(function()
			TweenService:Create(openButton, TweenInfo.new(0.12), {
				BackgroundColor3 = COLORS.PurpleLight,
			}):Play()
		end)
		openButton.MouseLeave:Connect(function()
			TweenService:Create(openButton, TweenInfo.new(0.12), {
				BackgroundColor3 = COLORS.Purple,
			}):Play()
		end)

		openButton.Activated:Connect(function()
			selectedEvent:Fire(game.Id, game.Name)

			-- ==============================
			-- TSB: Load external menu
			-- ==============================
			if game.Id == "TSB" then
				screen.Enabled = false -- Ẩn KATO HUB

				local success, err = pcall(function()
					loadstring(game:HttpGet("https://raw.githubusercontent.com/itsk4to/K-1/refs/heads/main/Game%20Menu%201"))()
				end)

				if not success then
					warn("[KATO HUB] Không thể load TSB Menu:", err)
					screen.Enabled = true -- Mở lại nếu lỗi
				end
			end
		end)
	end

	return card
end

local function makeCardGrid(parent)
	local grid = create("Frame", {
		Name = "GameCards",
		Size = UDim2.new(1, 0, 0, 206),
		BackgroundTransparency = 1,
	}, parent)
	local layout = create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -7, 0, 206),
		CellPadding = UDim2.fromOffset(12, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	for _, game in ipairs(GAMES) do
		makeGameCard(grid, game)
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		grid.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 2)
	end)
	return grid, layout
end

