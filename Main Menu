local function applyLanguage()
	local function translate(value)
		if currentLanguage == "VI" then
			return TRANSLATIONS[value] or value
		end
		for english, vietnamese in pairs(TRANSLATIONS) do
			if vietnamese == value then
				return english
			end
		end
		return value
	end

	for _, object in ipairs(screen:GetDescendants()) do
		if object:IsA("TextLabel") or object:IsA("TextButton") then
			object.Text = translate(object.Text)
		elseif object:IsA("TextBox") then
			object.PlaceholderText = translate(object.PlaceholderText)
		end
	end

	languageButton.Text = currentLanguage == "EN" and "ENGLISH  ▾" or "TIẾNG VIỆT  ▾"
end

languageButton.Activated:Connect(function()
	currentLanguage = currentLanguage == "EN" and "VI" or "EN"
	applyLanguage()
end)

applyLanguage()

