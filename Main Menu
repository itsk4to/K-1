local function notify(message, accentColor)
    local toast = create("Frame", {
        Name = "Toast",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -18, 1, 80),
        Size = UDim2.new(0, 270, 0, 48),
        BackgroundColor3 = CONFIG.PanelLight,
        BorderSizePixel = 0,
        ZIndex = 50,
    }, gui)
    corner(toast, 10)
    stroke(toast, accentColor or CONFIG.Accent, 0.35, 1)
    local bar = create("Frame", {
        Size = UDim2.new(0, 4, 1, -14),
        Position = UDim2.new(0, 7, 0, 7),
        BackgroundColor3 = accentColor or CONFIG.Accent,
        BorderSizePixel = 0,
        ZIndex = 51,
    }, toast)
    corner(bar, 4)
    create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 0),
        Size = UDim2.new(1, -28, 1, 0),
        Font = Enum.Font.Gotham,
        Text = message,
        TextColor3 = CONFIG.Text,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 51,
    }, toast)
    tween(toast, 0.25, { Position = UDim2.new(1, -18, 1, -18) })
    task.delay(2.7, function()
        if toast and toast.Parent then
            tween(toast, 0.2, { Position = UDim2.new(1, -18, 1, 80), BackgroundTransparency = 1 })
            task.delay(0.22, function()
                if toast then toast:Destroy() end
            end)
        end
    end)
end

local function getGameById(id)
    for _, gameInfo in ipairs(GAMES) do
        if gameInfo.id == id then return gameInfo end
    end
    return nil
end

local function addRecent(id)
    for index = #recentlyUsed, 1, -1 do
        if recentlyUsed[index] == id then
            table.remove(recentlyUsed, index)
        end
    end
    table.insert(recentlyUsed, 1, id)
    while #recentlyUsed > 8 do
        table.remove(recentlyUsed)
    end
end

--// Hàm quan trọng: Load menu bằng loadstring
local function launchGame(gameInfo)
    if not gameInfo then return end
    if gameInfo.status == "SOON" then
        notify(tr("soon"), CONFIG.Muted)
        return
    end

    addRecent(gameInfo.id)

    -- Nếu có Url thì dùng loadstring (Executor)
    if gameInfo.Url and gameInfo.Url \~= "" then
        -- Ẩn Main Hub
        if gui then
            gui.Enabled = false
        end

        local success, err = pcall(function()
            loadstring(game:HttpGet(gameInfo.Url))()
        end)

        if not success then
            warn("[KATO HUB] Load failed:", err)
            notify(tr("loadError"), CONFIG.Danger)
            if gui then
                gui.Enabled = true
            end
        else
            notify(tr("selected") .. gameInfo.name, CONFIG.Success)
        end
    else
        -- Không có Url thì chỉ thông báo
        notify(tr("selected") .. gameInfo.name, CONFIG.Success)
    end

    if currentPage == "recent" and showPage then
        task.defer(function() showPage("recent") end)
    end
end

