renderPage = function(key)
    local pageData = pages[key]
    if not pageData then return end
    local scroll = pageData.scroll
    clearScroll(scroll)
    addVerticalLayout(scroll, 10)

    if key == "home" then
        renderHome(scroll)
    elseif key == "games" or key == "favorites" or key == "recent" then
        renderGameCollection(key, scroll)
    elseif key == "settings" then
        renderSettings(scroll)
    end
end

updateNavigationLabels = function()
    for key, nav in pairs(navButtons) do
        if nav.title then nav.title.Text = tr(key) end
    end
end

showPage = function(key)
    if not pages[key] then return end
    currentPage = key
    for pageKey, pageData in pairs(pages) do
        pageData.frame.Visible = pageKey == key
    end
    for navKey, nav in pairs(navButtons) do
        local active = navKey == key
        tween(nav.button, 0.15, {
            BackgroundColor3 = active and CONFIG.AccentDark or CONFIG.Panel,
        })
        nav.icon.TextColor3 = active and CONFIG.Text or CONFIG.Muted
        if nav.title then
            nav.title.TextColor3 = active and CONFIG.Text or CONFIG.Muted
        end
    end
    renderPage(key)
end

