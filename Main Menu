local function updateGrid(grid, layout)
	if isMobile then
		layout.CellSize = UDim2.new(1, 0, 0, 196)
		layout.CellPadding = UDim2.fromOffset(0, 10)
	else
		layout.CellSize = UDim2.new(0.5, -6, 0, 206)
		layout.CellPadding = UDim2.fromOffset(12, 10)
	end
	task.defer(function()
		grid.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 2)
	end)
end

local function refreshLayout()
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1000, 700)
	isMobile = viewport.X < 720

	if isMinimized then
		return
	end

	local width
	local height
	if isMobile then
		width = math.max(260, math.min(viewport.X - 28, 410))
		height = math.max(300, math.min(viewport.Y - 110, 540))
	else
		width = math.min(850, viewport.X - 80)
		height = math.min(560, viewport.Y - 80)
		width = math.max(620, width)
		height = math.max(420, height)
	end

	window.Size = UDim2.fromOffset(width, height)
	window.Position = UDim2.fromScale(0.5, 0.5)
	topbar.Size = UDim2.new(1, 0, 0, isMobile and 54 or 62)
	body.Position = UDim2.fromOffset(0, isMobile and 54 or 62)
	body.Size = UDim2.new(1, 0, 1, -(isMobile and 54 or 62))

	if isMobile then
		sidebar.Size = UDim2.new(0, 48, 1, 0)
		pageHost.Position = UDim2.new(0, 48, 0, 0)
		pageHost.Size = UDim2.new(1, -48, 1, 0)
		sidebarTitle.Visible = false
		sidebarStatus.Visible = false
		brandSub.Visible = false
		brandName.Position = UDim2.fromOffset(58, 14)
		brandName.Size = UDim2.fromOffset(115, 22)
		brandName.TextSize = 15
		logo.Position = UDim2.fromOffset(12, 9)
		logo.Size = UDim2.fromOffset(34, 34)
		version.Visible = false

		for _, button in pairs(navButtons) do
			button.Size = UDim2.new(1, -8, 0, 40)
			button.Label.Visible = false
			button.Icon.Position = UDim2.fromOffset(0, 0)
			button.Icon.Size = UDim2.fromScale(1, 1)
			button.Icon.TextSize = 16
		end
		navHolder.Position = UDim2.fromOffset(4, 14)
		navHolder.Size = UDim2.new(1, -8, 0, 235)
		navLayout.Padding = UDim.new(0, 7)
	else
		sidebar.Size = UDim2.new(0, 178, 1, 0)
		pageHost.Position = UDim2.new(0, 178, 0, 0)
		pageHost.Size = UDim2.new(1, -178, 1, 0)
		sidebarTitle.Visible = true
		sidebarStatus.Visible = true
		brandSub.Visible = true
		brandName.Position = UDim2.fromOffset(64, 12)
		brandName.Size = UDim2.fromOffset(180, 22)
		brandName.TextSize = 17
		logo.Position = UDim2.fromOffset(18, 13)
		logo.Size = UDim2.fromOffset(36, 36)
		version.Visible = true

		for _, button in pairs(navButtons) do
			button.Size = UDim2.new(1, 0, 0, 42)
			button.Label.Visible = true
			button.Icon.Position = UDim2.fromOffset(7, 0)
			button.Icon.Size = UDim2.fromOffset(34, 42)
			button.Icon.TextSize = 17
		end
		navHolder.Position = UDim2.fromOffset(10, 48)
		navHolder.Size = UDim2.new(1, -20, 0, 245)
		navLayout.Padding = UDim.new(0, 7)
	end

	for _, page in pairs(pages) do
		local padding = page:FindFirstChildOfClass("UIPadding")
		if padding then
			local side = isMobile and 12 or 20
			padding.PaddingLeft = UDim.new(0, side)
			padding.PaddingRight = UDim.new(0, side)
			padding.PaddingTop = UDim.new(0, isMobile and 14 or 20)
			padding.PaddingBottom = UDim.new(0, 22)
		end
	end

	updateGrid(homeGrid, homeGridLayout)
	updateGrid(selectorGrid, selectorGridLayout)
end

-- Drag
local dragging = false
local dragStart = nil
local startPosition = nil

local function isTopbarButton(target)
	return target == minimizeButton or target == closeButton
end

topbar.InputBegan:Connect(function(input)
	if input.UserInputType \~= Enum.UserInputType.MouseButton1
		and input.UserInputType \~= Enum.UserInputType.Touch then
		return
	end

	local target = playerGui:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
	for _, guiObject in ipairs(target) do
		if isTopbarButton(guiObject) then
			return
		end
	end

	dragging = true
	dragStart = input.Position
	startPosition = window.Position

	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
		end
	end)
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		window.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

