local function updateResponsiveLayout()
    local size = getViewport()
    local wasMobile = isMobile
    isMobile = size.X < 720
    local width = math.max(300, math.min(1040, size.X - (isMobile and 16 or 80)))
    local height = math.max(420, math.min(690, size.Y - (isMobile and 24 or 80)))
    local newSidebarWidth = isMobile and 58 or 184
    tween(main, 0.18, { Size = UDim2.fromOffset(width, height) })
    if newSidebarWidth \~= sidebarWidth then
        sidebarWidth = newSidebarWidth
        sidebar.Size = UDim2.new(0, sidebarWidth, 1, -bodyTop)
        content.Position = UDim2.new(0, sidebarWidth, 0, bodyTop)
        content.Size = UDim2.new(1, -sidebarWidth, 1, -bodyTop)
        for _, nav in pairs(navButtons) do
            if nav.title then nav.title.Visible = not isMobile end
            nav.icon.Position = isMobile and UDim2.new(0.5, -14, 0, 4) or UDim2.fromOffset(7, 4)
        end
    end
    if wasMobile \~= isMobile then
        task.defer(function() showPage(currentPage) end)
    end
end

