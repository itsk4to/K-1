local function getFilteredGames(source)
    local filtered = {}
    local query = currentPage == "games" and string.lower(currentSearch or "") or ""
    for _, gameInfo in ipairs(source) do
        local haystack = string.lower((gameInfo.name or "") .. " " .. (gameInfo.category or "") .. " " .. (gameInfo.description or ""))
        if query == "" or string.find(haystack, query, 1, true) then
            table.insert(filtered, gameInfo)
        end
    end
    return filtered
end

