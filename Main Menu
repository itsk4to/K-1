--// Helpers
local function create(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function stroke(parent, color, transparency, thickness)
    return create("UIStroke", {
        Color = color or CONFIG.Accent,
        Transparency = transparency == nil and 0.65 or transparency,
        Thickness = thickness or 1,
    }, parent)
end

local function tween(object, duration, properties)
    local info = TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local animation = TweenService:Create(object, info, properties)
    animation:Play()
    return animation
end

local function makeLabel(parent, text, size, position, fontSize, color, bold)
    return create("TextLabel", {
        Name = "Label",
        BackgroundTransparency = 1,
        Text = text or "",
        Size = size,
        Position = position,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = fontSize or 14,
        TextColor3 = color or CONFIG.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = false,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, parent)
end

local function makeButton(parent, text, size, position, callback, style)
    style = style or "primary"
    local bg = style == "primary" and CONFIG.Accent or CONFIG.PanelLight
    local button = create("TextButton", {
        AutoButtonColor = false,
        Text = text,
        Size = size,
        Position = position,
        BackgroundColor3 = bg,
        TextColor3 = CONFIG.Text,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        BorderSizePixel = 0,
    }, parent)
    corner(button, 9)
    if style \~= "primary" then
        stroke(button, Color3.fromRGB(91, 82, 116), 0.55, 1)
    end
    button.MouseEnter:Connect(function()
        if button.Active then
            tween(button, 0.14, { BackgroundColor3 = style == "primary" and CONFIG.AccentDark or Color3.fromRGB(48, 43, 66) })
        end
    end)
    button.MouseLeave:Connect(function()
        tween(button, 0.14, { BackgroundColor3 = bg })
    end)
    button.Activated:Connect(function()
        if callback then callback() end
    end)
    return button
end

