local function renderGameCollection(key, scroll)
    local headingTitle = key == "games" and tr("allGames") or (key == "favorites" and tr("favorites") or tr("recent"))
    addPageHeading(scroll, headingTitle, tr("tagline"))

    local source = {}
    if key == "games" then
        source = GAMES
        addSearchBox(scroll, 2)
    elseif key == "favorites" then
        for _, gameInfo in ipairs(GAMES) do
            if favorites[gameInfo.id] then table.insert(source, gameInfo) end
        end
    elseif key == "recent" then
        for _, id in ipairs(recentlyUsed) do
            local gameInfo = getGameById(id)
            if gameInfo then table.insert(source, gameInfo) end
        end
    end

    local filtered = getFilteredGames(source)
    local startOrder = key == "games" and 3 or 2
    if #filtered == 0 then
        if key == "favorites" then
            addEmptyState(scroll, tr("noFavorites"), tr("emptyHint"), startOrder)
        elseif key == "recent" then
            addEmptyState(scroll, tr("noRecent"), tr("emptyHint"), startOrder)
        else
            addEmptyState(scroll, tr("noResults"), tr("emptyHint"), startOrder)
        end
        return
    end

    for index, gameInfo in ipairs(filtered) do
        makeGameCard(scroll, gameInfo, startOrder + index - 1)
    end
end

