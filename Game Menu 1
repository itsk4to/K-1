    local heading = textLabel(page, translate(tabId == "Visuals" and "Visuals" or tabId, language), 20, C.Text, Enum.Font.GothamBold)
    heading.Position = UDim2.fromOffset(0, 0)
    heading.Size = UDim2.new(1, 0, 0, 30)
    local desc = textLabel(page, translate(tabInfo[tabId], language), 11, C.Muted)
    desc.Position = UDim2.fromOffset(0, 31)
