applyResponsiveLayout = function()
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1000, 700)
    local mobile = viewport.X < 720
    local width
    local height
    if mobile then
        width = math.max(260, math.min(viewport.X - 24, 450))
        height = math.max(330, math.min(viewport.Y - 90, 680))
    else
        width = math.min(900, viewport.X - 70)
        height = math.min(620, viewport.Y - 70)
        width = math.max(600, width)
        height = math.max(420, height)
    end
    width = math.floor(width * menuScale)
    height = math.floor(height * menuScale)
    window.Size = UDim2.fromOffset(width, height)
    topbar.Size = UDim2.new(1, 0, 0, mobile and 52 or 60)
    body.Position = UDim2.fromOffset(0, mobile and 52 or 60)
    body.Size = UDim2.new(1, 0, 1, -(mobile and 52 or 60))
    isMobileLayout = mobile
    if mobile then
        sidebar.Size = UDim2.new(0, 48, 1, 0)
        sidebarCaption.Visible = false
        navHolder.Position = UDim2.fromOffset(5, 12)
        navHolder.Size = UDim2.new(1, -10, 0, 250)
