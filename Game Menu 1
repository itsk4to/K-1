        ClearTextOnFocus = false,
        BorderSizePixel = 0,
    }, builderCard)
    round(groupBox, 8)
    local addGroup = button(builderCard, translate("Add group", language), 96, 34, true)
    addGroup.Position = UDim2.new(1, -108, 0, 15)

    local scroll = make("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 146),
        Size = UDim2.new(1, 0, 1, -146),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.Purple,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, page)
    make("UIPadding", {
        PaddingRight = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 14),
    }, scroll)
    local groupList = make("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, scroll)

    local empty = textLabel(scroll, translate("No groups yet. Add a group to start building this tab.", language), 12, C.Muted)
    empty.Size = UDim2.new(1, -8, 0, 52)
    empty.TextXAlignment = Enum.TextXAlignment.Center
    empty.LayoutOrder = 1

    local function updateEmpty()
        empty.Visible = #layout[tabId] == 0
    end

    local function renderGroups()
        for _, child in ipairs(scroll:GetChildren()) do
            if child ~= groupList and child ~= empty and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        for groupIndex, groupData in ipairs(layout[tabId]) do
            local groupCard = card(scroll, 100 + (#groupData.buttons * 40))
            groupCard.LayoutOrder = groupIndex + 1

