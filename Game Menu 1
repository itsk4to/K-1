--// Simple page content
local function clearContent()
    for _, child in ipairs(ContentScroll:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
end

local function pageTitle(title, desc)
    local holder = create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 50),
    }, ContentScroll)

    makeLabel(holder, title, UDim2.new(1, 0, 0, 26), UDim2.new(), 18)
    makeLabel(holder, desc or "", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 28), 12, Theme.SubText)
end

local function infoCard(title, desc)
    local card = create("Frame", {
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, 0, 0, 70),
    }, ContentScroll)
    corner(card, 9)
    stroke(card)

    makeLabel(card, title, UDim2.new(1, -20, 0, 24), UDim2.fromOffset(12, 8), 14)
    makeLabel(card, desc, UDim2.new(1, -20, 0, 22), UDim2.fromOffset(12, 34), 12, Theme.SubText)
end

local function renderTab(tab)
    State.ActiveTab = tab
    clearContent()

    pageTitle("KATO HUB / " .. tr(tab), tr("Welcome"))

    if tab == "Combat" then
        infoCard("Combat Settings", "Tích hợp chức năng combat của bạn tại đây.")
        infoCard("Auto Features", "Các nút chức năng sẽ được thêm sau.")
    elseif tab == "Moveset" then
        infoCard("Moveset", "Quản lý bộ kỹ năng.")
    elseif tab == "Visuals" then
        infoCard("Visuals", "Tùy chỉnh giao diện.")
    elseif tab == "Misc" then
        infoCard("Miscellaneous", "Các tiện ích khác.")
    elseif tab == "Settings" then
        infoCard("Language", "Hiện tại: " .. State.Language)
        makeButton(ContentScroll, "Đổi ngôn ngữ (VI / EN)", function()
            State.Language = State.Language == "VI" and "EN" or "VI"
            renderTab("Settings")
        end)
        infoCard("Version", "KATO HUB TSB " .. CONFIG.VERSION)
    end
end

