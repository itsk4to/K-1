local function updateNav()
    for id, b in pairs(navButtons) do
        local active = id == activeTab
        b.BackgroundColor3 = active and C.Purple or C.Surface2
        b.TextColor3 = active and Color3.new(1, 1, 1) or C.Muted
        for _, tab in ipairs(tabs) do
            if tab.id == id then
                b.Text = isMobileLayout and tab.icon or (tab.icon .. "   " .. translate(tab.label, language))
                b.TextXAlignment = isMobileLayout and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
                b.TextSize = isMobileLayout and 17 or 11
                break
            end
        end
    end
end

