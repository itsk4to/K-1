local function make(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function outline(parent, color, transparency)
    return make("UIStroke", {
        Color = color or C.Border,
        Transparency = transparency or 0,
        Thickness = 1,
    }, parent)
end

local function textLabel(parent, text, size, color, font)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or C.Text,
        Font = font or Enum.Font.Gotham,
        TextSize = size or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function button(parent, text, width, height, accent)
    local b = make("TextButton", {
        Size = UDim2.fromOffset(width or 100, height or 32),
        BackgroundColor3 = accent and C.Purple or C.Surface3,
        Text = text,
        TextColor3 = C.Text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        AutoButtonColor = true,
        BorderSizePixel = 0,
    }, parent)
    round(b, 8)
    return b
end

