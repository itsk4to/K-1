openTSB = function()
    local mainGui = playerGui:FindFirstChild(MAIN_GUI_NAME)
    if mainGui and mainGui:IsA("ScreenGui") then
        mainGui.Enabled = false
    end
    isOpen = true
    isMinimized = false
    body.Visible = true
    minimize.Text = "—"
    screen.Enabled = true
    applyResponsiveLayout()
    window.Visible = false
    window.Position = UDim2.fromScale(0.5, 0.5)
    window.BackgroundTransparency = panelTransparency

    -- Show the TSB artwork intro first, then reveal the actual menu.
    task.spawn(function()
        playIntro()
        if not screen.Enabled or not isOpen then
            return
        end
        window.Visible = true
        applyResponsiveLayout()
        local targetWidth = window.Size.X.Offset
        local targetHeight = window.Size.Y.Offset
        window.Size = UDim2.fromOffset(targetWidth * 0.96, targetHeight * 0.96)
        TweenService:Create(window, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(targetWidth, targetHeight),
        }):Play()
    end)
end

