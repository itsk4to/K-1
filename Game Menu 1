local function playIntro()
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(800, 600)
    local cardWidth = math.max(270, math.min(420, viewport.X - 36))
    introCard.Size = UDim2.fromOffset(cardWidth, 310)
    introOverlay.Visible = true
    introOverlay.BackgroundTransparency = 1
    introCard.BackgroundTransparency = 1
    introBanner.ImageTransparency = 1
    introGameIcon.ImageTransparency = 1
    introTitle.TextTransparency = 1
    introSubtitle.TextTransparency = 1
    introLoading.TextTransparency = 1

    local fadeIn = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(introOverlay, fadeIn, { BackgroundTransparency = 0.2 }):Play()
    TweenService:Create(introCard, fadeIn, { BackgroundTransparency = 0 }):Play()
    TweenService:Create(introBanner, fadeIn, { ImageTransparency = 0 }):Play()
    TweenService:Create(introGameIcon, fadeIn, { ImageTransparency = 0 }):Play()
    TweenService:Create(introTitle, fadeIn, { TextTransparency = 0 }):Play()
    TweenService:Create(introSubtitle, fadeIn, { TextTransparency = 0 }):Play()
    TweenService:Create(introLoading, fadeIn, { TextTransparency = 0 }):Play()

    task.wait(1.35)
    local fadeOut = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(introOverlay, fadeOut, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(introCard, fadeOut, { BackgroundTransparency = 1 }):Play()
    TweenService:Create(introBanner, fadeOut, { ImageTransparency = 1 }):Play()
    TweenService:Create(introGameIcon, fadeOut, { ImageTransparency = 1 }):Play()
    TweenService:Create(introTitle, fadeOut, { TextTransparency = 1 }):Play()
    TweenService:Create(introSubtitle, fadeOut, { TextTransparency = 1 }):Play()
    TweenService:Create(introLoading, fadeOut, { TextTransparency = 1 }):Play()
    task.wait(0.32)
    introOverlay.Visible = false
end

