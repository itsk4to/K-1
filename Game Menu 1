local function renderBuilder(tabId)
    clearContent()
    local tabInfo = {
        Combat = "Build your own Combat layout.",
        Moveset = "Build your own Moveset layout.",
        Visuals = "Build your own Visuals layout.",
        Misc = "Build your own Misc layout.",
