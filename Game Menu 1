--// Toggle Key
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CONFIG.TOGGLE_KEY then
        Screen.Enabled = not Screen.Enabled
    end
end)

--// Performance
local frameCount, elapsed = 0, 0
RunService.RenderStepped:Connect(function(dt)
    if not Screen.Enabled then return end
    frameCount += 1
    elapsed += dt
    if elapsed >= 1 then
        State.FPS = math.floor(frameCount / elapsed)
        frameCount = 0
        elapsed = 0

        pcall(function()
            State.Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)

        StatusLabel.Text = "● FPS " .. State.FPS .. " | Ping " .. State.Ping
    end
end)

