-- Configurable hotkey for hiding/showing this menu after it has been opened once.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if waitingForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            selectedKey = input.KeyCode
            waitingForKey = false
            if activeTab == "Settings" and screen.Enabled then
                renderTab("Settings")
            end
        end
        return
    end

    if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if input.KeyCode == selectedKey then
        if isOpen then
            screen.Enabled = not screen.Enabled
        end
    end
end)

local elapsed = 0
local frameCount = 0
RunService.RenderStepped:Connect(function(dt)
    elapsed = elapsed + dt
    frameCount = frameCount + 1
    frameTimeValue = dt * 1000
    if elapsed >= 1 then
        fpsValue = math.floor(frameCount / elapsed + 0.5)
        pingValue = getPing()
        hudText.Text = "FPS  " .. tostring(fpsValue) .. "     PING  " .. tostring(pingValue)
        frameCount = 0
        elapsed = 0
    end
end)

