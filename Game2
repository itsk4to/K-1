local function createToggleRow(parent, titleText, initialState, callback)
    local row = make("Frame", { BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, 48), BorderSizePixel = 0 }, parent)
    corner(row, 10)
    stroke(row, Theme.Stroke, 0.7, 1)
