    local btn = makeButton(row, initialState and "BẬT" or "TẮT", UDim2.fromOffset(70, 26), UDim2.new(1, -78, 0.5, -13), initialState)
    local state = initialState
    btn.Activated:Connect(function()
        state = not state
        btn.Text = state and "BẬT" or "TẮT"
        setButtonBaseColor(btn, state and Theme.Accent or Theme.Surface3)
        callback(state)
    end)
    return row, btn
end

