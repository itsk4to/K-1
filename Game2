--// UI UTILITY BUILDERS
local function make(className, properties, parent)
    local obj = Instance.new(className)
    for prop, val in pairs(properties or {}) do
        obj[prop] = val
    end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function stroke(parent, color, transparency, thickness)
    return make("UIStroke", {
        Color = color or Theme.Stroke,
        Transparency = transparency == nil and 0.5 or transparency,
        Thickness = thickness or 1,
    }, parent)
end

local function tween(object, duration, properties)
    local anim = TweenService:Create(object, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    anim:Play()
    return anim
end

local function addPadding(parent, l, t, r, b)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0),
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, parent)
end

local function makeLabel(parent, textVal, size, color, font, alignment)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = textVal or "",
        TextColor3 = color or Theme.Text,
        TextSize = size or 14,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function makeButton(parent, textVal, size, position, primary)
    local btn = make("TextButton", {
        AutoButtonColor = false,
        Text = textVal or "",
        Size = size,
        Position = position or UDim2.new(),
        BackgroundColor3 = primary and Theme.Accent or Theme.Surface3,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        BorderSizePixel = 0,
    }, parent)
    corner(btn, 9)
    local baseColor = primary and Theme.Accent or Theme.Surface3
    btn:SetAttribute("BaseColor", baseColor)
    btn.MouseEnter:Connect(function()
        local cur = btn:GetAttribute("BaseColor") or baseColor
        tween(btn, 0.14, { BackgroundColor3 = cur:Lerp(Theme.AccentLight, 0.28) })
    end)
    btn.MouseLeave:Connect(function()
        local cur = btn:GetAttribute("BaseColor") or baseColor
        tween(btn, 0.14, { BackgroundColor3 = cur })
    end)
    return btn
end

local function setButtonBaseColor(btn, color)
    btn:SetAttribute("BaseColor", color)
    btn.BackgroundColor3 = color
end

local function makeCard(parent, height)
    local card = make("Frame", {
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 100),
    }, parent)
    corner(card, 12)
    stroke(card, Theme.Stroke, 0.72, 1)
    return card
end

