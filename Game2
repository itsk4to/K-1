performanceText.Size = UDim2.new(1, -8, 1, 0)
performanceText.Position = UDim2.fromOffset(4, 0)

local ESPObjects = {}

local function removeESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if typeof(obj) == "Instance" then obj:Destroy() end
        end
        ESPObjects[player] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then return end
    removeESP(player)

    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Head") then return end
    local rootPart = character.HumanoidRootPart
    local head = character.Head
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "KatoHighlight"
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0.1
    highlight.Adornee = character
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KatoBillboard"
    billboard.Size = UDim2.new(0, 140, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = head
    billboard.Parent = character

    local arrowLabel = Instance.new("TextLabel")
    arrowLabel.Size = UDim2.new(1, 0, 0, 16)
    arrowLabel.Position = UDim2.new(0, 0, 0, -16)
    arrowLabel.BackgroundTransparency = 1
    arrowLabel.TextSize = 12
    arrowLabel.Font = Enum.Font.GothamBold
    arrowLabel.Text = "▼"
    arrowLabel.TextStrokeTransparency = 0
    arrowLabel.Parent = billboard

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, -16)
    textLabel.Position = UDim2.new(0, 0, 0, 16)
    textLabel.BackgroundTransparency = 1
    textLabel.TextSize = 11
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = billboard

    local tracer = Instance.new("LineHandleAdornment")
    tracer.Name = "KatoTracer"
    tracer.Length = 0
    tracer.Thickness = 1.8
    tracer.ZIndex = 5
    tracer.AlwaysOnTop = true
    tracer.Adornee = workspace.Terrain
    tracer.Parent = character

    ESPObjects[player] = { 
        Highlight = highlight, 
        Billboard = billboard, 
        Text = textLabel, 
        Arrow = arrowLabel,
        Tracer = tracer, 
        Character = character, 
        Humanoid = humanoid, 
        RootPart = rootPart,
        Head = head
    }
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        if p.Character then createESP(p) end
        p.CharacterAdded:Connect(function() task.wait(0.4) createESP(p) end)
    end
end
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(0.4) createESP(p) end)
end)
Players.PlayerRemoving:Connect(removeESP)

local function checkObstacle(targetHead)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then return false end
    local origin = LocalPlayer.Character.Head.Position
    local direction = targetHead.Position - origin
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetHead.Parent}
    raycastParams.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, raycastParams)
    if result then
        return true 
    end
    return false
end

local frameCount, elapsed = 0, 0
RunService.RenderStepped:Connect(function(dt)
    frameCount += 1
    elapsed += dt
    performanceHud.Visible = HubConfig.ShowPerformanceHUD

    if elapsed >= 0.5 then
        local fps = math.floor(frameCount / elapsed + 0.5)
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000 + 0.5) end)
        performanceText.Text = string.format("FPS %d | PING %dms", fps, ping)
        frameCount, elapsed = 0, 0
    end

    local closestEnemyDist = 9999
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESPObjects) do
        if not data.Character:IsDescendantOf(workspace) or data.Humanoid.Health <= 0 then
            removeESP(player)
            continue
        end

        local isTeam = player.Team == LocalPlayer.Team and player.Team ~= nil
        local color = isTeam and TacticalConfig.TeamColor or TacticalConfig.EnemyColor

        data.Highlight.Enabled = TacticalConfig.HighlightEnabled
        data.Highlight.FillColor = color
        data.Highlight.OutlineColor = color
        data.Arrow.TextColor3 = color

        local dist = 0
        if myRoot then
            dist = math.round((data.RootPart.Position - myRoot.Position).Magnitude)
            if not isTeam and dist < closestEnemyDist then
                closestEnemyDist = dist
            end
        end

        local isHidden = false
        if TacticalConfig.ObstacleCheckEnabled and not isTeam then
            isHidden = checkObstacle(data.Head)
        end

        local txt = ""
        if TacticalConfig.ShowNames then txt = player.Name end
        if TacticalConfig.ShowDistance then txt = txt .. string.format(" [%dm]", dist) end
        
        if TacticalConfig.ObstacleCheckEnabled and not isTeam then
            if isHidden then
                txt = txt .. " [NÚP]"
            else
                txt = txt .. " [LỘ]"
            end
        end

        data.Text.TextColor3 = color
        data.Text.Text = txt

        if TacticalConfig.TracersEnabled and not isTeam and dist >= 10 and dist <= TacticalConfig.MaxDistance and myRoot then
            data.Tracer.Visible = true
            data.Tracer.CFrame = CFrame.new(myRoot.Position, data.Head.Position)
            data.Tracer.Length = (data.Head.Position - myRoot.Position).Magnitude
            data.Tracer.Color3 = color
        else
            data.Tracer.Visible = false
        end
    end

    if closestEnemyDist <= TacticalConfig.WarningDistance then
        warningLabel.Text = string.format("⚠️ CẢNH BÁO: ĐỊCH ÁP SÁT (%dm) ⚠️", closestEnemyDist)
        warningLabel.Visible = true
    else
        warningLabel.Visible = false
    end
end)

